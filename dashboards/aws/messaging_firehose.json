{
  "label": "beta",
  "metric_keys": [
    "aws_firehose_incoming_records"
  ],
  "dashboard": {
    "title": "AWS/Firehose",
    "description": "Monitor Firehose delivery streams: ingestion, S3 and HTTP endpoint delivery, PutRecord API latency and requests, throttling and rate limits, and KMS/validation errors.",
    "visuals": [
      {
        "type": "timeseries",
        "display": "line",
        "format": "size",
        "format_input": "byte",
        "draw_null_as_zero": true,
        "title": "Incoming Bytes",
        "description": "Bytes ingested into the delivery stream.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_incoming_bytes",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": true,
        "title": "Incoming Records",
        "description": "Number of records ingested into the delivery stream.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_incoming_records",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": true,
        "title": "Incoming Put Requests vs Incoming Records",
        "description": "Successful PutRecord and PutRecordBatch requests versus records ingested. A high records-to-requests ratio indicates effective batching.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_incoming_put_requests",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          },
          {
            "name": "aws_firehose_incoming_records",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "size",
        "format_input": "byte",
        "draw_null_as_zero": true,
        "title": "Delivery to S3 - Bytes",
        "description": "Bytes delivered to Amazon S3.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_s3_bytes",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": true,
        "title": "Delivery to S3 - Records",
        "description": "Records delivered to Amazon S3.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_s3_records",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "duration",
        "draw_null_as_zero": false,
        "title": "Delivery to S3 - Data Freshness",
        "description": "Age of the oldest record in the delivery stream. Higher values indicate delivery delays.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_s3_data_freshness",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": false,
        "title": "Delivery to S3 - Success",
        "description": "Sum of successful S3 put operations.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_s3_success",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "size",
        "format_input": "byte",
        "draw_null_as_zero": true,
        "title": "Delivery to HTTP Endpoint - Bytes vs Processed Bytes",
        "description": "Bytes delivered successfully to the HTTP endpoint versus the bytes attempted, including retries.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_http_endpoint_bytes",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          },
          {
            "name": "aws_firehose_delivery_to_http_endpoint_processed_bytes",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": true,
        "title": "Delivery to HTTP Endpoint - Records vs Processed Records",
        "description": "Records delivered successfully to the HTTP endpoint versus the records attempted, including retries.",
        "line_label": "%name% %DeliveryStreamName%",
        "metrics": [
          {
            "name": "aws_firehose_delivery_to_http_endpoint_records",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          },
          {
            "name": "aws_firehose_delivery_to_http_endpoint_processed_records",
            "fields": [{ "field": "GAUGE" }],
            "tags": [{ "key": "DeliveryStreamName", "value": "*" }]
          }
        ]
      },
      {
        "type": "timeseries",
        "display": "line",
        "format": "number",
        "draw_null_as_zero": false,
        "title": "Delivery to HTTP Endpoint - Success",
